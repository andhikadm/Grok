# ── Required ──────────────────────────────────────
# MAIL_MODE=api atau imap. Jika imap, set variabel IMAP di bawah.
MAIL_MODE=api
MAIL_ORIGIN=https://your-mail-api.example.com
MAILBOX_DOMAIN=your-domain.com
CAPTCHA_KEY=0x4AAAAAAAhr9JGVDZbrZOo0

# ── IMAP Settings (Diperlukan jika MAIL_MODE=imap) ─
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=your_email@example.com
IMAP_PASS=your_email_password
IMAP_DOMAIN=yourdomain.com
IMAP_FOLDER=INBOX

# ── Optional (defaults shown) ────────────────────
# EXPORT_PATH=accounts.txt
# SHOW_BROWSER=False
# CONCURRENCY=3
# POLL_GAP=3
# POLL_MAX=60
# CAPTCHA_WINDOW=25
# NETWORK_TIMEOUT=10
# ACCOUNT_TIMEOUT=180
# NINEROUTER_DB=C:\Users\Administrator\AppData\Roaming\9router\db\data.sqlite
